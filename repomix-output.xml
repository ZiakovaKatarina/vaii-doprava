    {% csrf_token %}
    <h3>Pridať zastávku</h3>
    
    <label for="stop">Zastávka:</label>
    <select name="stop" id="stop" required>
        <option value="">-- vyber zastávku --</option>
        {% for s in stops %}
            <option value="{{ s.id }}">{{ s.name }}</option>
        {% endfor %}
    </select>
    
    <label for="order" style="margin-left: 15px;">Poradie (voliteľné):</label>
    <input type="number" name="order" id="order" min="1" placeholder="Ak ponechaš prázdne, bude na konci">
    
    <button type="submit" class="btn btn-primary" style="margin-left: 15px;">Pridať</button>
</form>

{% if route_stops %}
    <h3>Zastávky na linke ({{ route_stops.count }})</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Poradie</th>
                <th>Názov zastávky</th>
                <th>Zemepisné súradnice</th>
                <th>Akcie</th>
            </tr>
        </thead>
        <tbody>
            {% for rs in route_stops %}
                <tr>
                    <td><strong>{{ rs.order }}</strong></td>
                    <td>{{ rs.stop.name }}</td>
                    <td>{{ rs.stop.latitude }}, {{ rs.stop.longitude }}</td>
                    <td>
                        <a href="{% url 'frontend:route_stop_delete' route.id rs.id %}" 
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Naozaj chcete odstrániť túto zastávku z trasy?')">
                            ✕ Odstrániť
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p style="color: #999;">Zatiaľ žiadne zastávky na tejto linke (okrem štartu a cieľa).</p>
{% endif %}

{% endblock %}
</file>

