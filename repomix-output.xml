                    <th>Linka</th>
                    <th>Vozidlo</th>
                    <th>Zastávka (odchod)</th>
                    <th>Zastávka (príchod)</th>
                    <th>Čas odchodu</th>
                    <th>Čas príchodu</th>
                    <th>Akcie</th>
                </tr>
            </thead>
            <tbody>
                {% for trip in trips %}
                    <tr>
                        <td>{{ trip.route.name }}</td>
                        <td>{% if trip.vehicleID %}{{ trip.vehicleID.registration_number }}{% else %}-{% endif %}</td>
                        <td>{{ trip.route.start_stop.name }}</td>
                        <td>{{ trip.route.end_stop.name }}</td>
                        <td>{{ trip.departure_time }}</td>
                        <td>{{ trip.arrival_time }}</td>
                        <td>
                            
                            {% if user.is_staff or user.is_superuser %}
                                <a href="{% url 'frontend:trip_update' trip.pk %}" class="btn btn-sm btn-primary">Upraviť</a>
                                <a href="{% url 'frontend:trip_delete' trip.pk %}" class="btn btn-sm btn-danger">Zmazať</a>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                    </tr>
                {% empty %}
                    <tr>
                        <td colspan="7">Žiadne spoje.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
