{% extends "base.html" %}

{% block content %}
<h2>Vyhľadanie spojenia</h2>

<div class="card">
    <h3 style="margin-bottom: 1.5rem;">Mapa zastávok</h3>
    
    <div style="margin-bottom: 10px; position: relative; z-index: 100;">
        <input type="text" id="map-stop-search" placeholder="🔍 Hľadať zastávku..." style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
    </div>
    <div id="map-search-results" style="position: absolute; width: 100%; background: white; z-index: 1000; border-radius: 0 0 8px 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
    <div id="map" style="height: 400px; width: 100%; border-radius: 8px; z-index: 1;"></div>
</div>

<form method="get" action="{% url 'frontend:search_connections' %}" style="max-width: 700px;">
  <label>Odkiaľ</label>
  <select name="start_stop" required>
    <option value="">-- vyber --</option>
    {% for s in stops %}
      <option value="{{ s.id }}" {% if start_id == s.id|stringformat:"s" %}selected{% endif %}>{{ s.name }}</option>
    {% endfor %}
  </select>

  <label style="margin-top:10px;">Kam</label>
  <select name="end_stop" required>
    <option value="">-- vyber --</option>
    {% for s in stops %}
      <option value="{{ s.id }}" {% if end_id == s.id|stringformat:"s" %}selected{% endif %}>{{ s.name }}</option>
    {% endfor %}
  </select>

  <div style="margin-top:12px;">
    <button type="submit" class="btn btn-primary">Hľadať</button>
  </div>
</form>

{% if start_stop and end_stop %}
  <div style="margin-top: 25px;">
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
      <h3 style="margin: 0;">Výsledky: {{ start_stop.name }} → {{ end_stop.name }}</h3>
      
      {% if user.is_authenticated %}
        <button id="btn-add-favorite" 
                class="btn btn-outline" 
                style="padding: 5px 10px; font-size: 0.9rem; white-space: nowrap;"
                data-start="{{ start_stop.name }}" 
                data-end="{{ end_stop.name }}">
          ⭐ Pridať do obľúbených
        </button>
      {% endif %}
    </div>

    <div id="favorite-status" style="margin-bottom: 15px; font-size: 0.85rem; display: none;"></div>

    {% if direct_connections %}
      <div style="margin-top: 15px;">
        {% if direct_connections.0.has_times %}
          <h4>Priame spoje:</h4>
          <table class="table" style="margin-top: 10px;">
            <thead>
              <tr>
                <th>Linka</th>
                <th>Odchod</th>
                <th>Príchod</th>
                <th>Vozidlo</th>
              </tr>
            </thead>
            <tbody>
              {% for c in direct_connections %}
                <tr>
                  <td><strong>{{ c.route.name }}</strong></td>
                  <td>{{ c.trip.departure_time|time:"H:i" }}</td>
                  <td>{{ c.trip.arrival_time|time:"H:i" }}</td>
                  <td>{{ c.trip.vehicleID.registration_number|default:"-" }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p style="margin-top: 15px;">
            Existuje priama linka <strong>{{ direct_connections.0.route.name }}</strong>.
          </p>
        {% endif %}
      </div>

    {% elif transfer_connections %}
      <div style="margin-top: 15px;">
        <h4>Navrhované prestupy:</h4>
        <p style="margin: 10px 0;">Priame spojenie neexistuje. Môžete prestúpiť:</p>
        <ul style="margin-top: 10px; list-style-type: disc; padding-left: 25px; line-height: 1.6;">
          {% for t in transfer_connections %}
            <li>
              Linkou <strong>{{ t.route1.name }}</strong> na zastávku <strong>{{ t.stop_x.name }}</strong> 
              a tam prestúpiť na linku <strong>{{ t.route2.name }}</strong>.
            </li>
          {% endfor %}
        </ul>
      </div>

    {% else %}
      <p style="margin-top: 15px; color: #666;">Nebolo nájdené žiadne spojenie.</p>
    {% endif %}
  </div>
{% endif %}

{% endblock %}

{% block extra_js %}
<script id="stops-data" type="application/json">
[
    {% for s in stops %}
        {% if s.latitude and s.longitude %}
        {
            "id": {{ s.id }},
            "name": "{{ s.name|escapejs }}",
            "lat": {{ s.latitude|stringformat:"f" }},
            "lon": {{ s.longitude|stringformat:"f" }}
        }{% if not forloop.last %},{% endif %}
        {% endif %}
    {% endfor %}
]
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var map = L.map('map').setView([49.223, 18.740], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var geocoder = L.Control.geocoder({
        defaultMarkGeocode: false,
        placeholder: "🔍 Hľadať adresu (ulicu, mesto)...",
        errorMessage: "Adresa nebola nájdená."
    })
    .on('markgeocode', function(e) {
        var bbox = e.geocode.bbox;
        var poly = L.polygon([
            bbox.getSouthEast(),
            bbox.getNorthEast(),
            bbox.getNorthWest(),
            bbox.getSouthWest()
        ]);
        map.fitBounds(poly.getBounds());
    })
    .addTo(map);

    var markerMap = {}; 
    var stopsElement = document.getElementById('stops-data');

    if (stopsElement) {
        var stopsData = JSON.parse(stopsElement.textContent);
        stopsData.forEach(function(s) {
            var marker = L.marker([s.lat, s.lon]).addTo(map);
            
            var popupContent = `
                <div style="text-align:center;">
                    <b style="font-size:1.1rem;">${s.name}</b><br>
                    <div style="display:flex; gap:5px; margin-top:8px;">
                        <button onclick="setPoint(${s.id}, '${s.name.replace(/'/g, "\\'")}', 'start')" 
                                style="cursor:pointer; background:#28a745; color:white; border:none; padding:5px 10px; border-radius:4px; flex:1;">
                            Štart
                        </button>
                        <button onclick="setPoint(${s.id}, '${s.name.replace(/'/g, "\\'")}', 'end')" 
                                style="cursor:pointer; background:#dc3545; color:white; border:none; padding:5px 10px; border-radius:4px; flex:1;">
                            Cieľ
                        </button>
                    </div>
                </div>
            `;
            
            marker.bindPopup(popupContent);
            markerMap[s.name.toLowerCase()] = { marker: marker, lat: s.lat, lon: s.lon };
        });
    }

    window.setPoint = function(id, name, type) {
        var startSelect = document.querySelector('select[name="start_stop"]');
        var endSelect = document.querySelector('select[name="end_stop"]');

        if (type === 'start') {
            if (endSelect.value == id) {
                alert("❌ Táto zastávka je už nastavená ako cieľ.");
                return;
            }
            startSelect.value = id;
            alert("✅ Nastavený štart: " + name);
        } else {
            if (startSelect.value == id) {
                alert("❌ Táto zastávka je už nastavená ako štart.");
                return;
            }
            endSelect.value = id;
            alert("🏁 Nastavený cieľ: " + name);
        }
        map.closePopup();
    };

    var searchInput = document.getElementById('map-stop-search');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            var query = e.target.value.toLowerCase().trim();
            if (query.length < 2) return;

            for (var name in markerMap) {
                if (name.includes(query)) {
                    var target = markerMap[name];
                    map.flyTo([target.lat, target.lon], 15);
                    target.marker.openPopup();
                    break;
                }
            }
        });
    }

    const favBtn = document.getElementById('btn-add-favorite');
    const statusDiv = document.getElementById('favorite-status');
    if (favBtn) {
        favBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
            fetch("{% url 'personalization:add_favorite_ajax' %}", {
                method: "POST",
                headers: { "Content-Type": "application/json", "X-CSRFToken": csrfToken },
                body: JSON.stringify({ start: this.dataset.start, end: this.dataset.end })
            })
            .then(res => res.json())
            .then(data => {
                statusDiv.style.display = "block";
                statusDiv.style.color = data.ok ? "green" : "red";
                statusDiv.textContent = (data.ok ? "✅ " : "❌ ") + data.message;
                if (data.ok) favBtn.disabled = true;
            });
        });
    }
});
</script>
{% endblock %}
</file>

