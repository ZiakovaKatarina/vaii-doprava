{% extends "base.html" %}
{% load static %}

{% block content %}
<div class="card">
    <h2 style="margin-bottom: 1.5rem;">{{ title }}</h2>
    
    <div style="margin-bottom: 20px;">
        <div id="search-container"></div>
        
        <label id="map-label" style="margin-top: 10px; display: block;">📍 Vyberte polohu (kliknite na mapu alebo hľadajte adresu):</label>
        
        <div id="stop-map" style="height: 350px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1; margin-top:10px;"></div>
        <small style="color: #666;">Červený marker určuje súradnice novej zastávky.</small>
    </div>

    <form id="stop-form" method="post" action="{% if stop %}{% url 'frontend:stop_update' stop.pk %}{% else %}{% url 'frontend:stop_create' %}{% endif %}">
        {% csrf_token %}
        {% for field in form %}
            <div class="form-row">
                <label>{{ field.label }}</label>
                {{ field }}
                <div class="alert alert-error js-error-box" style="display:none; color:red; font-size:0.9rem; margin-top:5px;"></div>
                {% if field.errors %}
                    <div class="alert alert-error" style="color:red; font-size:0.9rem;">{{ field.errors.0 }}</div>
                {% endif %}
            </div>
        {% endfor %}

        <div style="margin-top: 20px;">
            <button class="btn btn-primary" type="submit">Uložiť zastávku</button>
            <a class="btn btn-outline" href="{% url 'frontend:stop_list' %}">Späť</a>
        </div>
    </form>
</div>
{% endblock %}

{% block extra_js %}
<script src="{% static 'js/ajax-forms.js' %}"></script>

<script id="stops-data" type="application/json">
[
    {% for s in stops %}
        {% if s.latitude and s.longitude %}
        {
            "name": "{{ s.name|escapejs }}",
            "lat": {{ s.latitude|stringformat:"f" }},
            "lon": {{ s.longitude|stringformat:"f" }}
        }{% if not forloop.last %},{% endif %}
        {% endif %}
    {% endfor %}
]
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const latInput = document.querySelector('input[name="latitude"]');
    const lonInput = document.querySelector('input[name="longitude"]');
    const nameInput = document.querySelector('input[name="name"]');
    
    let initialLat = parseFloat(latInput.value);
    let initialLon = parseFloat(lonInput.value);
    
    if (isNaN(initialLat) || isNaN(initialLon)) {
        initialLat = 49.223;
        initialLon = 18.740;
        latInput.value = initialLat.toFixed(6);
        lonInput.value = initialLon.toFixed(6);
    }

    const map = L.map('stop-map').setView([initialLat, initialLon], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    const mainMarker = L.marker([initialLat, initialLon], {
        draggable: true,
        zIndexOffset: 1000,
        icon: L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        })
    }).addTo(map);

    function updateInputs(lat, lon) {
        latInput.value = lat.toFixed(6);
        lonInput.value = lon.toFixed(6);
    }

    // --- 2. Hľadanie existujúcich zastávok ---
    const stopsData = JSON.parse(document.getElementById('stops-data').textContent);
    const markerMap = {};
    stopsData.forEach(s => {
        if (s.name !== nameInput.value) {
            const m = L.marker([s.lat, s.lon]).addTo(map).bindPopup("Existujúca zastávka: " + s.name);
            markerMap[s.name.toLowerCase()] = { lat: s.lat, lon: s.lon, marker: m };
        }
    });

    const internalSearch = document.createElement('input');
    internalSearch.type = 'text';
    internalSearch.placeholder = '🔍 Skočiť na existujúcu zastávku...';
    internalSearch.className = 'form-input';
    internalSearch.style.marginBottom = '10px';

    document.getElementById('search-container').appendChild(internalSearch);

    internalSearch.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        if (query.length < 2) return;
        for (const name in markerMap) {
            if (name.includes(query)) {
                map.flyTo([markerMap[name].lat, markerMap[name].lon], 16);
                markerMap[name].marker.openPopup();
                break;
            }
        }
    });

    L.Control.geocoder({
        placeholder: "🌍 Hľadať ulicu/adresu...",
        defaultMarkGeocode: false
    }).on('markgeocode', function(e) {
        const center = e.geocode.center;
        mainMarker.setLatLng(center);
        map.setView(center, 18);
        updateInputs(center.lat, center.lng);
    }).addTo(map);

    map.on('click', e => {
        mainMarker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
    });

    mainMarker.on('dragend', () => {
        const pos = mainMarker.getLatLng();
        updateInputs(pos.lat, pos.lng);
    });
});
</script>
{% endblock %}
</file>

