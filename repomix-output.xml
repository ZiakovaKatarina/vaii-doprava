</div>

<script>
    const regexRoute = /^[a-zA-Z0-9áäčďéíľĺňóôŕšťúýžÁÄČĎÉÍĽĹŇÓÔŔŠŤÚÝŽ\s-]{2,}$/;
    
    const nameInput = document.querySelector('input[name="name"]');
    nameInput && nameInput.addEventListener('input', function() {
