        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('vehicle-form');
    const regInput = document.querySelector('input[name="registration_number"]');
    const regexSPZ = /^[A-Z]{2}-?[0-9]{3}[A-Z]{2}$|^[A-Z0-9-]{4,10}$/;

    function validateSPZ() {
        const val = regInput.value.toUpperCase().trim();
        const errorDiv = regInput.parentElement.querySelector('.js-error-msg');

        if (val.length > 0 && !regexSPZ.test(val)) {
            regInput.setCustomValidity("Invalid");
            errorDiv.textContent = "Zadajte platný formát ŠPZ (napr. ZA-123AB).";
            errorDiv.style.display = "block";
            regInput.style.borderColor = "red";
        } else {
            regInput.setCustomValidity("");
            errorDiv.style.display = "none";
            regInput.style.borderColor = "";
        }
    }

    if (regInput) {
        regInput.addEventListener('input', validateSPZ);
    }

    form.addEventListener('submit', function(e) {
        validateSPZ();
        if (!form.checkValidity()) {
            e.preventDefault();
            form.reportValidity();
        }
    });
});
</script>
{% endblock %}
</file>

