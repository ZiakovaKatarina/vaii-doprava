@require_http_methods(["DELETE", "POST"])
def stop_delete(request, pk):
    try:
        stop = get_object_or_404(Stop, pk=pk)
        stop.delete()
        if request.headers.get('x-requested-with') == 'XMLHttpRequest':
            return JsonResponse({'ok': True})
