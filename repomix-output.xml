                <label for="{{ field.id_for_label }}">{{ field.label }}</label>
                {{ field }}
                
                <div class="alert alert-error js-error-msg" style="display:none; margin-top: 0.3rem; font-size: 0.85rem;"></div>
                
                {% if field.errors %}
                    <div class="alert alert-error" style="display:block; margin-top: 0.3rem;">
                        {{ field.errors.0 }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button class="btn btn-primary" type="submit" style="flex: 1;">Uložiť vozidlo</button>
